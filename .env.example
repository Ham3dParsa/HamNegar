# نمونه متغیرهای محیطی — کپی به .env و پر کن
# هرگز .env را کامیت نکن — فقط .env.example

# Groq Whisper (console.groq.com/keys)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Gemini Auth (aistudio.google.com/apikey — فرمت جدید AQ....)
GEMINI_API_KEY=AQ.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# مدل پیش‌فرض رونویسی
GEMINI_MODEL=gemini-flash-latest

# موتور اولویت‌دار: groq | gemini
PRIMARY_ENGINE=groq

# حالت آنی مرورگر: true | false
REALTIME=false

# VAD ارسال پس از سکوت: true | false
VAD=true

# کپی خودکار پس از درج: true | false
AUTOCOPY=false

# پورت سرور محلی
PORT=8000
