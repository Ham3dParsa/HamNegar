<Window x:Class="HamNegar.Native.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         Height="640" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" FontFamily="Segoe UI"
        Background="{DynamicResource BgBrush}">
    <!-- NOTE: no user-facing literals in this file (Lang.cs owns all strings;
         code-behind ApplyLang() fills every label/tooltip/title/combo). -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
        <StackPanel>
            <!-- (keys stay) API keys -->
            <Border Style="{DynamicResource CardStyle}">
                <StackPanel>
                    <TextBlock x:Name="ApiKeysHeader" Text="" Style="{DynamicResource SectionTitleStyle}"/>
                    <TextBlock x:Name="GoogleKeyLabel" Text="" Style="{DynamicResource FieldLabelStyle}"/>
                    <PasswordBox x:Name="GoogleKeyBox" Margin="0,0,0,8"/>
                    <TextBlock x:Name="GroqKeyLabel" Text="" Style="{DynamicResource FieldLabelStyle}"/>
                    <PasswordBox x:Name="GroqKeyBox" Margin="0,0,0,8"/>
                    <TextBlock x:Name="KeysHint" Text=""
                               Style="{DynamicResource HintStyle}"/>
                </StackPanel>
            </Border>

            <!-- (a) SHORTCUTS: click-to-record hotkeys, persisted to settings JSON -->
            <Border Style="{DynamicResource CardStyle}">
                <StackPanel>
                    <TextBlock x:Name="ShortcutsHeader" Text="" Style="{DynamicResource SectionTitleStyle}"/>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="RecordLabel" Text="" Foreground="{DynamicResource TextBrush}" FontSize="12" FontFamily="Segoe UI"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="RecordHotkeyButton" Grid.Column="1"
                                Style="{DynamicResource RecordHotkeyStyle}"
                                Click="HotkeyButton_Click"
                                PreviewKeyDown="HotkeyButton_PreviewKeyDown"
                                LostKeyboardFocus="HotkeyButton_LostFocus"/>
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ShowHideLabel" Text="" Foreground="{DynamicResource TextBrush}" FontSize="12" FontFamily="Segoe UI"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="ShowHideHotkeyButton" Grid.Column="1"
                                Style="{DynamicResource RecordHotkeyStyle}"
                                Click="HotkeyButton_Click"
                                PreviewKeyDown="HotkeyButton_PreviewKeyDown"
                                LostKeyboardFocus="HotkeyButton_LostFocus"/>
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="CancelRecLabel" Text="" Foreground="{DynamicResource TextBrush}" FontSize="12" FontFamily="Segoe UI"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="CancelHotkeyButton" Grid.Column="1"
                                Style="{DynamicResource RecordHotkeyStyle}"
                                Click="HotkeyButton_Click"
                                PreviewKeyDown="HotkeyButton_PreviewKeyDown"
                                LostKeyboardFocus="HotkeyButton_LostFocus"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="ResetHotkeysButton" Content=""
                                Style="{DynamicResource SecondaryButtonStyle}"
                                Click="ResetHotkeysButton_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="ShortcutsHint" Text=""
                               Style="{DynamicResource HintStyle}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- (b) CHAIN EDITOR: STT + Polish editable over ChainEngine -->
            <Border Style="{DynamicResource CardStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="SttChainHeader" Text="" Style="{DynamicResource SectionTitleStyle}" VerticalAlignment="Center"/>
                        <Button x:Name="ResetSttButton" Content="" Style="{DynamicResource SecondaryButtonStyle}" Grid.Column="1" Click="ResetSttButton_Click"/>
                    </Grid>
                    <ItemsControl x:Name="SttChainItems" IsTabStop="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,6,0" Checked="ChainEnabled_Changed" Unchecked="ChainEnabled_Changed" Tag="{Binding Id}"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Id}" Foreground="{DynamicResource TextBrush}" FontSize="11" FontFamily="Consolas, Segoe UI" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Note}" Foreground="{DynamicResource MutedBrush}" FontSize="10" FontFamily="Segoe UI"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="&#xE70E;" FontFamily="{StaticResource IconFont}" Style="{DynamicResource IconButtonStyle}" Margin="4,0,2,0" Click="SttUp_Click" Tag="{Binding Id}"/>
                                    <Button Grid.Column="3" Content="&#xE70D;" FontFamily="{StaticResource IconFont}" Style="{DynamicResource IconButtonStyle}" Click="SttDown_Click" Tag="{Binding Id}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="SttHint" Text="" Style="{DynamicResource HintStyle}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{DynamicResource CardStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PolishChainHeader" Text="" Style="{DynamicResource SectionTitleStyle}" VerticalAlignment="Center"/>
                        <Button x:Name="ResetPolishButton" Content="" Style="{DynamicResource SecondaryButtonStyle}" Grid.Column="1" Click="ResetPolishButton_Click"/>
                    </Grid>
                    <ItemsControl x:Name="PolishChainItems" IsTabStop="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,6,0" Checked="ChainEnabled_Changed" Unchecked="ChainEnabled_Changed" Tag="{Binding Id}"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Id}" Foreground="{DynamicResource TextBrush}" FontSize="11" FontFamily="Consolas, Segoe UI" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Sub}" Foreground="{DynamicResource MutedBrush}" FontSize="10" FontFamily="Segoe UI" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="&#xE70E;" FontFamily="{StaticResource IconFont}" Style="{DynamicResource IconButtonStyle}" Margin="4,0,2,0" Click="PolishUp_Click" Tag="{Binding Id}"/>
                                    <Button Grid.Column="3" Content="&#xE70D;" FontFamily="{StaticResource IconFont}" Style="{DynamicResource IconButtonStyle}" Margin="0,0,2,0" Click="PolishDown_Click" Tag="{Binding Id}"/>
                                    <Button Grid.Column="4" Content="&#xE74D;" FontFamily="{StaticResource IconFont}" Style="{DynamicResource IconButtonStyle}" Click="RemoveCustom_Click" Tag="{Binding Id}" Visibility="{Binding RemoveVisibility}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="PolishHint" Text="" Style="{DynamicResource HintStyle}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{DynamicResource CardStyle}">
                <StackPanel>
                    <TextBlock x:Name="CustomHeader" Text="" Style="{DynamicResource SectionTitleStyle}"/>
                    <TextBlock x:Name="CustomIdLabel" Text="" Style="{DynamicResource FieldLabelStyle}"/>
                    <TextBox x:Name="CustomIdBox" Margin="0,0,0,4"/>
                    <TextBlock x:Name="CustomNameLabel" Text="" Style="{DynamicResource FieldLabelStyle}"/>
                    <TextBox x:Name="CustomNameBox" Margin="0,0,0,4"/>
                    <TextBlock x:Name="CustomBaseLabel" Text="" Style="{DynamicResource FieldLabelStyle}"/>
                    <TextBox x:Name="CustomBaseBox" Margin="0,0,0,4"/>
                    <TextBlock x:Name="CustomKeyLabel" Text="" Style="{DynamicResource FieldLabelStyle}"/>
                    <PasswordBox x:Name="CustomKeyBox" Margin="0,0,0,4"/>
                    <TextBlock x:Name="CustomModelLabel" Text="" Style="{DynamicResource FieldLabelStyle}"/>
                    <TextBox x:Name="CustomModelBox" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="AddCustomButton" Content="" Style="{DynamicResource PrimaryButtonStyle}" Click="AddCustomButton_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="CustomHint" Text="" Style="{DynamicResource HintStyle}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- (c) OPTIONS (extensible: new rows go above the checkboxes) -->
            <Border Style="{DynamicResource CardStyle}">
                <StackPanel>
                    <TextBlock x:Name="OptionsHeader" Text="" Style="{DynamicResource SectionTitleStyle}"/>
                    <TextBlock x:Name="ThemeLabel" Text="" Style="{DynamicResource FieldLabelStyle}"/>
                    <ComboBox x:Name="ThemeComboBox" Margin="0,0,0,4"
                              SelectionChanged="ThemeComboBox_SelectionChanged"/>
                    <TextBlock x:Name="LangLabel" Text="" Style="{DynamicResource FieldLabelStyle}"/>
                    <ComboBox x:Name="LanguageComboBox" Margin="0,0,0,4"
                              SelectionChanged="LanguageComboBox_SelectionChanged"/>
                    <TextBlock x:Name="InjectLabel" Text="" Style="{DynamicResource FieldLabelStyle}"/>
                    <ComboBox x:Name="InjectModeComboBox" Margin="0,0,0,4"/>
                    <CheckBox x:Name="HotkeyShowsPillCheck" Content=""/>
                    <CheckBox x:Name="AutoCopyCheck" Content=""/>
                    <CheckBox x:Name="ShowEngineLabelCheck" Content=""/>
                    <CheckBox x:Name="VerboseStatusCheck" Content=""/>
                    <TextBlock x:Name="OptionsHint" Text=""
                               Style="{DynamicResource HintStyle}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- Footer -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
                <Button x:Name="SaveButton" Content="" Style="{DynamicResource PrimaryButtonStyle}"
                        Margin="0,0,8,0" Click="SaveButton_Click" IsDefault="True"/>
                <Button x:Name="CancelButton" Content="" Style="{DynamicResource SecondaryButtonStyle}"
                        Click="CancelButton_Click" IsCancel="True"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" Text="" Foreground="{DynamicResource MutedBrush}" FontSize="11" FontFamily="Segoe UI"
                       Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Right"/>
        </StackPanel>
    </ScrollViewer>
</Window>
