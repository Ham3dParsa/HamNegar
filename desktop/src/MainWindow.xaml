<Window x:Class="HamNegar.Native.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         Height="300" Width="320" MinWidth="250" MinHeight="260"
        Topmost="True" ShowInTaskbar="False"
        WindowStyle="None" ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True" Background="Transparent"
        FontFamily="Segoe UI">
    <Window.Resources>
        <!-- Icon/text button base styles live in App.xaml (IconButtonStyle, PrimaryButtonStyle,
             SecondaryButtonStyle). Only the bespoke mic button stays local. -->
        <Style x:Key="MicButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="60"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="30">
                            <Border.Effect>
                                <DropShadowEffect Color="#1A73E8" Opacity="0.45" BlurRadius="16" ShadowDepth="0"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="0.94" ScaleY="0.94"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Border Margin="6" CornerRadius="18" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="8">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.45" BlurRadius="18" ShadowDepth="0"/>
        </Border.Effect>
        <StackPanel>
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="TitleLabel" Text="" Foreground="{DynamicResource MutedBrush}" FontSize="11" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button x:Name="HistoryButton" Content="&#xE81C;" Style="{StaticResource IconButtonStyle}" Margin="0,0,4,0" Click="HistoryButton_Click"/>
                    <Button x:Name="SettingsButton" Content="&#xE713;" Style="{StaticResource IconButtonStyle}" Margin="0,0,4,0" Click="SettingsButton_Click"/>
                    <Button x:Name="HideButton" Content="&#xE921;" Style="{StaticResource IconButtonStyle}" Margin="0,0,4,0" Click="HideButton_Click"/>
                    <Button x:Name="CloseButton" Content="&#xE8BB;" Style="{StaticResource IconButtonStyle}" Click="CloseButton_Click"/>
                </StackPanel>
            </DockPanel>

            <Grid Width="80" Height="80" Margin="0,8,0,0" HorizontalAlignment="Center">
                <Border x:Name="PulseRing" Width="72" Height="72" CornerRadius="36"
                        BorderBrush="{DynamicResource DangerBrush}" BorderThickness="2"
                        Visibility="Collapsed" Opacity="0.9"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                    </Border.RenderTransform>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <Trigger Property="Visibility" Value="Visible">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard Name="PulseBegin">
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="1" To="1.08" Duration="0:0:1.1"/>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="1" To="1.08" Duration="0:0:1.1"/>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.Opacity)" From="0.9" To="0" Duration="0:0:1.1"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="PulseBegin"/>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <Button x:Name="MicButton" Content="&#xE720;" Style="{StaticResource MicButtonStyle}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Click="MicButton_Click"/>
            </Grid>

            <TextBlock x:Name="StatusText" Text=""
                        Foreground="{DynamicResource TextBrush}" FontSize="11" FontFamily="Segoe UI" TextWrapping="Wrap"
                          Margin="0,6,0,0" HorizontalAlignment="Center" TextAlignment="Center"/>
            <StackPanel x:Name="ActionRow" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                <Button x:Name="CancelActionButton" Content="&#xE711;" Style="{StaticResource IconButtonStyle}"
                        Margin="0,0,6,0" Visibility="Collapsed" Click="CancelActionButton_Click"/>
                <Button x:Name="RetryButton" Content="&#xE72C;" Style="{StaticResource IconButtonStyle}"
                        Margin="0,0,6,0" Visibility="Collapsed" Click="RetryButton_Click"/>
                <Button x:Name="DiscardButton" Content="&#xE74D;" Style="{StaticResource IconButtonStyle}"
                        Visibility="Collapsed" Click="DiscardButton_Click"/>
            </StackPanel>
            <Border CornerRadius="10" Background="{DynamicResource HoverBrush}" Padding="7,2" Margin="0,4,0,0" HorizontalAlignment="Center">
                <TextBlock x:Name="EngineText" Text=""
                            Foreground="{DynamicResource AccentSoftBrush}" FontSize="10" FontFamily="Segoe UI"
                            HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="220"/>
            </Border>

        </StackPanel>
    </Border>
</Window>
